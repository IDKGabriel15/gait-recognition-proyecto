<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A12">

    <!-- Visor de Cámara Principal en Horizontal -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomPanel" />

    <!-- Capa de dibujo de esqueleto biométrico y reproducción de video en horizontal -->
    <ImageView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- HUD Superior: Indicador de Modo Activo -->
    <TextView
        android:id="@+id/modeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#DD0F172A"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="● MODO CÁMARA EN VIVO"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Miniatura de Silueta Normalizada OpenGait (HUD Flotante) -->
    <LinearLayout
        android:id="@+id/silContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:background="#CC0F172A"
        android:padding="4dp"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomPanel">

        <ImageView
            android:id="@+id/silhouettePreview"
            android:layout_width="52dp"
            android:layout_height="76dp"
            android:background="#000000"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SILUETA"
            android:textColor="#94A3B8"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Panel de Control Lateral para Modo Horizontal -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#F00F172A"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Badge de Motor Offline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#991E293B"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="⚡ 31 SUJETOS OFFLINE"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Barra de progreso para análisis de video -->
        <LinearLayout
            android:id="@+id/videoProgressLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/videoProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analizando video: 0%"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/videoProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#38BDF8" />
        </LinearLayout>

        <!-- Tarjeta de Identificación Biométrica -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#991E293B"
            android:padding="10dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando modelos offline..."
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/top3Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Top-3: --"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Botonera de Acciones en Vertical -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Iniciar"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#030712"
                android:backgroundTint="#38BDF8"
                android:enabled="false"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Reiniciar"
                android:textSize="12sp"
                android:textColor="#F8FAFC"
                android:backgroundTint="#1E293B"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnVideo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Importar Video"
                android:textSize="12sp"
                android:textColor="#F8FAFC"
                android:backgroundTint="#1E293B" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
