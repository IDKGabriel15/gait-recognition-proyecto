<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- Vista previa de la cámara en horizontal -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomPanel" />

    <!-- Capa de dibujo de esqueleto, siluetas y video en horizontal -->
    <ImageView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- Badge indicador de modo actual -->
    <TextView
        android:id="@+id/modeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="#CC161B22"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="● MODO CÁMARA EN VIVO"
        android:textColor="#58A6FF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Miniatura de silueta normalizada OpenGait 64x44 -->
    <ImageView
        android:id="@+id/silhouettePreview"
        android:layout_width="56dp"
        android:layout_height="82dp"
        android:layout_margin="10dp"
        android:background="#CC000000"
        android:padding="2dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomPanel" />

    <!-- Panel de control lateral para modo horizontal (mantiene id bottomPanel para compatibilidad de código) -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="260dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#161B22"
        android:padding="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Barra de progreso para análisis de video -->
        <LinearLayout
            android:id="@+id/videoProgressLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/videoProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analizando video: 0%"
                android:textColor="#58A6FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/videoProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#58A6FF" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando modelos offline..."
            android:textColor="#7EE787"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/top3Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Top-3: --"
            android:textColor="#C9D1D9"
            android:textSize="11sp" />

        <!-- Botonera de acciones en columna vertical para horizontal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciar"
                android:enabled="false"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reiniciar"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Importar Video" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

